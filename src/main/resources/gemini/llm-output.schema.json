{
  "type": "object",
  "description": "Gemini가 강의 노트로 생성하는 학습 콘텐츠 (LLM 출력 원본)",
  "properties": {
    "title": { "type": "string", "description": "자료 전체 제목. 20자 이내." },
    "topics": {
      "type": "array",
      "description": "노트를 주제 단위로 나눈 블록. 2~4개.",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "description": "주제명. 15자 이내. 예: 프로세스란?" },
          "summaryCards": {
            "type": "array",
            "description": "요약 카드 1~2장.",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "heading": { "type": "string", "description": "카드 제목. 15자 이내." },
                "body": { "type": "string", "description": "2~4문장, 200자 이내. 노트에 있는 내용만." }
              },
              "required": ["heading", "body"]
            }
          },
          "ttsScript": {
            "type": "string",
            "description": "오디오 모드용 낭독 대본. 말하듯 자연스럽게, 기호·괄호·화살표·약어 나열 금지. 영문 약어는 한글 발음 병기. 300자 이내."
          },
          "terms": {
            "type": "array",
            "description": "단어 카드 1~3개.",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "term": { "type": "string", "description": "용어. 20자 이내." },
                "definition": { "type": "string", "description": "한 문장 정의. 80자 이내." }
              },
              "required": ["term", "definition"]
            }
          }
        },
        "required": ["title", "summaryCards", "ttsScript", "terms"]
      }
    },
    "quizzes": {
      "type": "array",
      "description": "4지선다 퀴즈 정확히 5문항.",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "topicIndex": { "type": "integer", "description": "topics 배열의 0부터 시작하는 인덱스", "minimum": 0, "maximum": 3 },
          "question": { "type": "string", "description": "질문. 80자 이내." },
          "options": {
            "type": "array",
            "description": "보기 4개. 서로 달라야 함.",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "string", "description": "보기. 40자 이내." }
          },
          "answerIndex": { "type": "integer", "description": "정답 보기의 0부터 시작하는 인덱스", "minimum": 0, "maximum": 3 },
          "explanation": { "type": "string", "description": "정답 해설. 100자 이내." },
          "evidence": { "type": "string", "description": "정답 근거가 된 노트 원문 구절을 그대로 인용. 100자 이내." }
        },
        "required": ["topicIndex", "question", "options", "answerIndex", "explanation", "evidence"]
      }
    }
  },
  "required": ["title", "topics", "quizzes"]
}
